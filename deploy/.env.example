# Copy to .env on the server and fill in.

# Public hostname of the VM. Without a domain, use the IP with dashes: 1.2.3.4 -> 1-2-3-4.sslip.io
SITE_ADDRESS=1-2-3-4.sslip.io

# Origin of the web app (Cloudflare Pages), comma-separated if several.
ALLOWED_ORIGINS=https://wigglegram.pages.dev
# Optional: also allow Cloudflare Pages preview deployments.
# ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.wigglegram\.pages\.dev$

# Cloudflare Turnstile secret key. Empty = bot check off.
TURNSTILE_SECRET=

# Optional tuning (see api/src/wigglegram/config.py for all settings)
# DEPTH_RES=1024
# MAX_QUEUE=8
# RATE_DEPTH=5/600,30/86400
# LOG_LEVEL=INFO
